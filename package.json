{
  "name": "powershell-browser",
  "productName": "PowerShell Browser",
  "version": "0.4.0",
  "description": "A standalone browser inside a faithful classic PowerShell console interface.",
  "main": "main.js",
  "private": true,
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "verify": "electron . --self-test",
    "package": "node package.mjs",
    "installer": "electron-builder --config electron-builder.json --win nsis --x64 --publish never",
    "site:dev": "node site/dev.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
